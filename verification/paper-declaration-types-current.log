                      LE.le.{0} B₀ B →
                        LT.lt.{0} L (HPow.hPow.{0, 0, 0} (↑N) (HSub.hSub.{0, 0, 0} 2 δ)) →
                          ∀ (V : ℕ → ℝ),
                            (∀ (ℓ : ℕ),
                                LT.lt.{0} 0 ℓ →
                                  LT.lt.{0} (↑ℓ) L →
                                    LE.le.{0} (V ℓ)
                                      (HMul.hMul.{0, 0, 0} (√(HDiv.hDiv.{0, 0, 0} (HPow.hPow.{0, 0, 0} (↑N) 2) ↑ℓ))
                                        (HPow.hPow.{0, 0, 0} (Real.log ↑N) (Neg.neg.{0} B)))) →
                              ∀ (a : Prod.{0, 0} ℕ ℕ → ℕ),
                                (∀ (i : Prod.{0, 0} ℕ ℕ),
                                    Membership.mem.{0, 0} (PrimeSquares.goldbachCoefficientIndices L V) i →
                                      (a i).Coprime i.2) →
                                  ∀ (d : Prod.{0, 0} ℕ ℕ → ℂ),
                                    (∀ (i : Prod.{0, 0} ℕ ℕ),
                                        Membership.mem.{0, 0} (PrimeSquares.goldbachCoefficientIndices L V) i →
                                          LE.le.{0} (Norm.norm.{0} (d i)) 1) →
                                      LE.le.{0}
                                        (∑ n ∈ Finset.range (HPow.hPow.{0, 0, 0} N 2),
                                          HPow.hPow.{0, 0, 0}
                                            (Norm.norm.{0}
                                              (∑ i ∈ PrimeSquares.goldbachCoefficientIndices L V,
                                                HMul.hMul.{0, 0, 0} (d i)
                                                  (PrimeSquares.goldbachFullRemainder ψ N i.1 i.2 (a i)
                                                    (HPow.hPow.{0, 0, 0} (Real.log ↑N) C) n)))
                                            2)
                                        (HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} K (HPow.hPow.{0, 0, 0} (↑N) 4))
                                          (HPow.hPow.{0, 0, 0} (Real.log ↑N) (Neg.neg.{0} A)))
