  (ψ : SchwartzMap.{0, 0} ℝ ℝ) (hψ : Ne.{1} ψ 0) (hsψ : ∀ (x : ℝ), LE.le.{0} (1 / 8) (abs.{0} x) → Eq.{1} (ψ x) 0)
  {A δ : ℝ} (hA : LT.lt.{0} 0 A) (hδ : LT.lt.{0} 0 δ) :
  ∃ B₀ C K,
    LE.le.{0} Cmin C ∧
      LE.le.{0} 0 B₀ ∧
        LT.lt.{0} 0 C ∧
          LT.lt.{0} 0 K ∧
            ∃ N₀,
              LE.le.{0} 4 N₀ ∧
                ∀ (N : ℕ),
